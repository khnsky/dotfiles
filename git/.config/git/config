[alias]
    # Interactively add chunks (add -p) of an untracked file.
    addnp           = "!c() { git add -N "$@" && git add -p "$@" ; }; c"

    # -s, --short : give output in the short-format
    # -b, --branch: show the branch and tracking info even in short-format
    sb              = status -sb

    # --graph   : draw a text-based graphical representation of the commit history.
    # --oneline : shorthand for --pretty=oneline --abbrev-commit
    #   --pretty=oneline: use format <hash> <title-line>
    #   --abbrev-commit : use abbreviated commmit sha
    # --decorate: print out the ref names of commits, ref name prefixes omitted.
    ll              = log --graph --oneline --decorate

    # --force-with-lease: only force if remote ref is the expected value
    # --force-if-includes: force only if tip of remote included locally
    #
    # source: https://blog.timhutt.co.uk/against-submodules/
    pushf = push --force-with-lease --force-if-includes

[branch]
    # Sort branches by reverse commit date - last commit first.
    sort            = -committerdate

[color]
    # Use colored output when connected to terminal.
    ui              = auto

[column]
    # Supported commands output in columns if output is to terminal.
    ui              = auto

[commit]
    # Not sure if this is right but:
    #   1 - show diff in commit message editor
    #   2 - also show diff between unstaged changes?
    verbose         = 1

[core]
    # Global gitignore file.
    excludesfile    = ~/.config/git/ignore

    # Enable untracked cache feature of the index which speeds up git operation.
    # May be unsafe on systems where mtime doesn't work correctly:
    # weird/networked/old/virtualized filesystems.  In such cases one can use
    # `git update-index --no-untracked-cache`.
    # See also: feature.manyFiles
    untrackedCache = true

[diff]
    # Improved patience diff algorithm, much better than default myers.
    algorithm       = histogram

    # Color moved lines of code.
    colormoved      = plain

    # Replace standard a/ and b/ prefixes with more meaningful i/ (index), w/
    # (working tree) or c/ (commit).
    mnemonicPrefix  = true

    # Detect simple renames, as well as copies.
    renames         = copies

    # The `log` format lists the commits in range like `git submodule summary`.
    submodule       = log

[fetch]
    # Behave as if --prune option was given - remove any remote-tracking
    # references that no longer exist on remote.
    prune           = true
    pruneTags       = true

    # Try fetching all available remotes.  Can be overridden with --no-all or
    # by specifying remote(s) to fetch from.
    all             = true

    # Maximal number of fetch operations to be run in parallel at a time.
    # A value of 0 will give some reasonable default.
    parallel        = 0

[help]
    autocorrect     = immediate

[init]
    defaultbranch   = master

[interactive]
    # Allow user to provide one-letter input with single key (without hitting
    # the Enter key) in interactive commands.
    singleKey       = true

[log]
    # Use abbreviated commit sha.
    abbrevCommit    = true

[merge]
    ff              = no
    conflictStyle   = zdiff3

[pull]
    # Only fast-forward merges are allowed.
    # If you want rebase use `git pull --rebase`.
    ff              = only

[push]
    # Automatically create branch on remote if missing.
    autoSetupRemote = true
    default         = simple

    # Enable --follow-tags option by default, to override use
    # --no-follow-tags.  Push tags that are missing from remote but are
    # reachable form refs being pushed.
    followTags      = true

    # Check if checked-out commits of submodules are available on at least one
    # remote and fail otherwise.  Other good option is on-demand that will
    # also automatically push the missing submodule commits and fails if that
    # failed.
    recurseSubmodules = check

[rebase]
    # When doing interactive rebase automatically reorder --fixup and --squash commits.
    autoSquash = true
    # When rebasing stacked branches update refs pointing to rebased commits.
    updateRefs = true

[rerere]
    # Activate recording of resolved conflicts, so that identical conflicting
    # hunks can be resolved automatically, should they be encountered again.
    enabled         = true
    # Update the index with resulting contents after cleanly resolving
    # conflicts using previously recorded resolutions.
    autoupdate      = true

[status]
    # Enable --branch by default, override by using --no-branch.  Show branch
    # and tracking info even in short-format.
    branch          = true
    # Show number of currently stashed entries.
    showStash       = true
    # Shows individual untracked files even in directories containing only
    # untracked files.  To do so git needs to `lstat()` all the files in the
    # whole repository which might be slow on some systems.
    showUntrackedFiles = all
    # Show summary of commits for modified submodules.
    submoduleSummary = true

[submodule]
    # Enable --recurse-submodules by default for commands that support it (with
    # exception of clone, ls-files. Branch unless experimental
    # submodule.propagateBranches is enabled).  Can be disabled with
    # --no-recurse-submodules, however some commands that do not have that
    # option call other commands that use this setting.  A workaround for these
    # is to call `git -c submodule.recurse=false ...`
    recurse         = true

[tag]
    # Default value used for sorting tags if --sort was not used.
    # version:refname makes it so tags are treated and sorted in version order
    # instead of alphabetically.  The sort order can be also affected by
    # "versionsort.suffix" configuration variable.
    sort            = version:refname

[user]
    email           = khnsky@khnsky.cc
    name            = Piotrek Kochański

# Local overrides
# If include.path doesn't exist git just ignores it.  By creating this file we
# can provide local (for specific PC or work-specific overrides).  Contents of
# this file are inserted immediately, so that this overrides must be at the
# very end.
[include]
    # Subject to tilde-expansion, if relative the path is considered relative
    # to file containing the include directive.
    path            = local.config
